{
  "name": "open3dcalc-desktop",
  "private": true,
  "version": "1.7.0",
  "description": "Open3DCalc Desktop - Calculadora de custos de impressão 3D com SQLite",
  "main": "electron/dist/electron/main.js",
  "scripts": {
    "dev": "concurrently -n vite,electron \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:desktop",
    "build:renderer": "tsc -b && vite build",
    "build:desktop": "npm run build:electron && electron-builder",
    "build:win": "npm run build:renderer && npm run build:electron && electron-builder --win --x64",
    "build:win:arm64": "npm run build:renderer && npm run build:electron && electron-builder --win --arm64",
    "build:win:dir": "npm run build:renderer && npm run build:electron && electron-builder --win --dir --x64",
    "build:win:helper": "bash scripts/build-win.sh x64",
    "build:mac": "npm run build:renderer && npm run build:electron && electron-builder --mac",
    "build:linux": "npm run build:renderer && npm run build:electron && electron-builder --linux",
    "build:all": "npm run build:renderer && npm run build:electron && electron-builder --win --mac --linux",
    "build:electron": "tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "sync": "bash scripts/sync-upstream.sh",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@react-pdf/renderer": "^4.0.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.40.0",
    "framer-motion": "^12.0.0",
    "i18next": "^26.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.0",
    "recharts": "^2.0.0",
    "three": "^0.184.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.0",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.30.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "electron-rebuild": "^3.2.9",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
    "appId": "com.open3dcalc.desktop",
    "productName": "Open3DCalc",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/dist/**/*",
      "dist/**/*",
      "package.json",
      "db/migrations/*.sql"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "public/icon.png",
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64", "universal"]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "public/icon.icns",
      "hardenedRuntime": true,
      "artifactName": "${productName}-${version}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "Utility",
      "icon": "public/icon.png",
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
